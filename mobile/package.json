{
  "name": "keycove-mobile",
  "private": true,
  "version": "1.0.0",
  "description": "Keycove iOS + Android shell (Capacitor). Packages resolve from the repo root node_modules; do NOT run pnpm install in this folder.",
  "scripts": {
    "sync": "cap sync",
    "sync:dev:android": "CAP_SERVER_URL=http://10.0.2.2:3000 cap sync android",
    "sync:dev:ios": "CAP_SERVER_URL=http://localhost:3000 cap sync ios",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "assets": "npx --yes @capacitor/assets@4.0.0 generate --iconBackgroundColor '#FFFFFF' --iconBackgroundColorDark '#0F1F4B' --splashBackgroundColor '#0F1F4B' --splashBackgroundColorDark '#0F1F4B'",
    "android:debug": "cd android && ./gradlew assembleDebug",
    "android:bundle": "cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "10.0.0",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/camera": "8.2.6",
    "@capacitor/core": "8.6.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.0",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0"
  }
}
