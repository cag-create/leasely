# ── Database ──────────────────────────────────────────────────────────────────
# Railway MySQL: use ${{MySQL.DATABASE_URL}} as a reference variable
DATABASE_URL=mysql://user:password@host:3306/leasely

# ── Auth (JWT) ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_64_char_random_hex

# ── Stripe Payments ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email (Brevo) ─────────────────────────────────────────────────────────────
BREVO_API_KEY=xkeysib-...
FROM_EMAIL=Leasely <noreply@yourdomain.com>

# ── File Storage (Cloudinary — free tier) ─────────────────────────────────────
# Sign up free at https://cloudinary.com (25 GB free, no credit card)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Maps (optional) ───────────────────────────────────────────────────────────
# Get a free key at https://console.cloud.google.com
VITE_GOOGLE_MAPS_API_KEY=

# ── AI Features ───────────────────────────────────────────────────────────────
# Anthropic Claude — powers AI application screening (required for that feature)
ANTHROPIC_API_KEY=sk-ant-...
# OpenAI — used for chat, image gen, voice transcription (optional)
OPENAI_API_KEY=

# ── App Identity ──────────────────────────────────────────────────────────────
NODE_ENV=production
VITE_APP_TITLE=Leasely

# ── Admin Setup ───────────────────────────────────────────────────────────────
# Your email address — gets auto-promoted to super admin on first login
OWNER_EMAIL=you@yourdomain.com
